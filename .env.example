# GapShield environment variables — NAMES ONLY. Copy to .env and fill locally.
# Never commit .env. Never put private keys here; deploy with a Foundry keystore account.

# --- Contracts / deployment (Foundry) ---
# Public RPC is rate-limited; an Alchemy/dRPC Robinhood Testnet endpoint is an optional fallback.
ROBINHOOD_TESTNET_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
# Name of the encrypted keystore created with `cast wallet import <name> --interactive`
DEPLOYER_ACCOUNT=

# --- Oracle (server-side only; never expose to the browser) ---
PYTH_PRO_API_KEY=

# --- Optional account abstraction (server-side; not on the critical path) ---
ZERODEV_PROJECT_ID=

# --- Web app (public, non-secret) ---
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_DEMO_MODE=
NEXT_PUBLIC_PYTH_ENABLED=
NEXT_PUBLIC_ZERODEV_ENABLED=
